# Copy this file to .env and replace the API key locally.
# The project loads NLP/.env automatically; .env values override process environment variables.
# Never commit a real API key.

LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=replace_with_your_deepseek_api_key

# Alternative key variable (use one key variable, not both):
# DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key